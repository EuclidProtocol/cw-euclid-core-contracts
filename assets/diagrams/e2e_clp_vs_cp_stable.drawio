          <mxGeometry x="20" y="30" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Factory (source chain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="Relayer / IBC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
