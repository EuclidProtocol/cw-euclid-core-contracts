        </mxCell>
        <mxCell id="13" value="Router (hub chain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="30" width="210" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="Concentrated VLP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="30" width="210" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="100" value="1) Execute on Factory:\nSwap/Add/Remove/CollectConcentratedFees/CollectConcentratedProtocolFees" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="101" value="2) Factory pre-validation\n- validate recipient\n- pool exists in POOL_KEY_TO_VLP\n- owner/admin checks\n- metadata optional fallback for collect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="290" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="102" value="3) Save pending request by (sender, tx_id)\n4) Build RouterCrossChainExecuteMsg::*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="250" width="290" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="103" value="5) Relay packet Factory -&gt; Router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="620" y="255" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="104" value="6) Router receive\n- chain_uid + sender checks\n- decode message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="850" y="110" width="250" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="105" value="7) Resolve target CLP by PoolKey:\nCONCENTRATED_VLPS[pool_key_to_map_key(pool_key)]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="850" y="215" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="106" value="8) Router stores pending tx_id\n9) SubMsg execute on Concentrated VLP:\nCollectFees / CollectProtocolFees / Swap / Add / Remove" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="850" y="320" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="107" value="10) VLP executes + returns response\n11) For collect flows, payout is voucher transfer\nto CrossChainUser recipient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1180" y="320" width="280" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="108" value="12) Router reply handler\n- parse VLP response\n- clear router pending tx_id\n- set data: AcknowledgementMsg::Ok/Error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="850" y="450" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="109" value="13) Relay ack Router -&gt; Factory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="620" y="465" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="110" value="14) Factory ack handler\n- parse ConcentratedCollect*Response\n- clear factory pending\n- idempotent on duplicate ack\n- native error returns Err; IBC error is non-stuck cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="290" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="111" value="15) User observes finalized result\n(voucher delta, updated metadata, no stuck pending state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="120" value="CLP-specific points" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1180" y="130" width="280" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="121" value="- Explicit PoolKey (pair + pool_type + fee_tier)\n- Position owner checks for CollectFees\n- Protocol-fee admin path via CollectProtocolFees\n- Collect payouts remain vouchers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingTop=6;" vertex="1" parent="120">
          <mxGeometry x="0" y="0" width="280" height="155" as="geometry"/>
